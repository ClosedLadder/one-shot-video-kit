# scores.jsonl — schema (lines starting with # are comments, not data)
#
# One line per scored run. Append-only. A run is reproducible from
# (kit_version + brief + model + seed) — record all four.
#
# SCHEMA (all fields required unless marked optional):
# {
#   "ts":            "ISO-8601 timestamp of scoring, e.g. 2026-09-24T19:30:00-04:00",
#   "kit_version":   "kit VERSION at run time, e.g. 0.1.0",
#   "brief":         "brief id, e.g. brief-1-logo-sting",
#   "model":         "capability class + model, e.g. frontier-reasoning/opus-5.5",
#   "tier":          "BEST | STUDIO | DRAFT",
#   "pipeline":      "code-film | mixed-flow | ai-footage",
#   "seed":          "deterministic seed(s) used, e.g. 42 (optional for ai-footage)",
#   "scores":        {"visual": 1-5, "story": 1-5, "audio_sync": 1-5,
#                     "consistency": 1-5, "technical": 1-5},
#   "judge":         "who scored creative dims, e.g. steven | agent-self | blind-panel",
#   "cost_usd":      "total API spend for the run, e.g. 0.00",
#   "wallclock_min": "wall-clock minutes brief→ship, e.g. 95",
#   "review_loops":  "self-review loop count, e.g. 3",
#   "pass":          "true if avg(scores) >= 4.0",
#   "notes":         "free text: what worked, what failed, fixes applied (optional)"
# }
#
# EXAMPLE (commented out — copy, uncomment, fill):
# {"ts":"2026-09-24T19:30:00-04:00","kit_version":"0.1.0","brief":"brief-1-logo-sting","model":"frontier-reasoning/opus-5.5","tier":"STUDIO","pipeline":"code-film","seed":42,"scores":{"visual":4,"story":4,"audio_sync":5,"consistency":5,"technical":5},"judge":"agent-self","cost_usd":0.00,"wallclock_min":95,"review_loops":3,"pass":true,"notes":"2nd loop fixed headline hold time (reading audit); proof frame proof/frame_04.2s.png"}
